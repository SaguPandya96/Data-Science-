FROM python:3.14.6-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AUTHENTITEXT_ROOT=/app

WORKDIR /app

RUN groupadd --system authentitext \
    && useradd --system --gid authentitext --home-dir /app --shell /usr/sbin/nologin authentitext

COPY requirements/runtime.lock requirements/runtime.lock
RUN python -m pip install --no-cache-dir --upgrade pip==26.1.2 \
    && python -m pip install --no-cache-dir -r requirements/runtime.lock

COPY scripts/download_runtime_artifacts.py scripts/download_runtime_artifacts.py
COPY data/metadata/runtime_artifact_manifest.json data/metadata/runtime_artifact_manifest.json
RUN python scripts/download_runtime_artifacts.py \
        --manifest data/metadata/runtime_artifact_manifest.json \
        --output-dir artifacts/baselines/id

COPY pyproject.toml README.md ./
COPY src ./src
COPY data/metadata ./data/metadata
RUN python -m pip install --no-cache-dir --no-deps . \
    && chown -R authentitext:authentitext /app

USER authentitext

EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('PORT', '10000') + '/health/ready', timeout=2).read()"]

CMD ["sh", "-c", "exec python -m uvicorn authentitext.api:app --host 0.0.0.0 --port ${PORT:-10000} --no-access-log"]
