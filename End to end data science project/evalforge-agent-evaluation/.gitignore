# Evaluation working data, all regenerated by `evalforge demo`.
#
# The reports in reports/ ARE committed: they are the demonstration's deliverable and
# are small. Traces and per-run scenario copies are not — they are ~50MB, they are a
# byte-identical function of the seed, and `scripts/regenerate_demo.py` rebuilds them.
data/generated_scenarios/*.jsonl
data/demonstration_runs/**/traces/
data/demonstration_runs/**/scenarios.jsonl
data/demonstration_runs/**/*.db
data/demonstration_runs/**/*.sqlite
reports/*.html
*.duckdb
*.sqlite
*.db

# Keep directory placeholders
!.gitkeep

