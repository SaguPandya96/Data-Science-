# EvalForge environment configuration.
#
# EvalForge runs completely offline with the deterministic mock provider.
# Every API key below is OPTIONAL. Never commit a filled-in copy of this file.

# Which model provider the agent under test should use.
# Supported: mock | anthropic | openai
EVALFORGE_PROVIDER=mock

# Optional: enables the AnthropicModelProvider. Absent -> provider is unavailable.
ANTHROPIC_API_KEY=

# Optional: enables the OpenAI-compatible provider. Absent -> provider is unavailable.
OPENAI_API_KEY=

# Optional: override the OpenAI-compatible base URL (vLLM, Ollama, Azure, ...).
OPENAI_BASE_URL=

# Optional: override the model id used by the selected external provider.
EVALFORGE_MODEL=

# Optional: LLM-as-a-judge provider. Supported: mock | anthropic | openai
EVALFORGE_JUDGE_PROVIDER=mock

# Logging: DEBUG | INFO | WARNING | ERROR, and console | json
EVALFORGE_LOG_LEVEL=INFO
EVALFORGE_LOG_FORMAT=console

# Root directory for generated artifacts (defaults to <package root>/data)
EVALFORGE_DATA_DIR=
